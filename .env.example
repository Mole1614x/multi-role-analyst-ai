# Compose requires unique values for the database password.
POSTGRES_PASSWORD=
# Separate URL-safe password, or encode reserved characters in the DATABASE_URL.
POSTGRES_USER=analyst
POSTGRES_DB=analyst
ANALYST_ORIGIN=http://localhost:3000
ANALYST_COOKIE_SECURE=false
ANALYST_LLM_PROVIDER=none
# ANALYST_LLM_PROVIDER=openai or gemini
ANALYST_LLM_MODEL=
ANALYST_LLM_API_KEY=
ANALYST_LLM_INPUT_COST_PER_MILLION=0
ANALYST_LLM_OUTPUT_COST_PER_MILLION=0
ANALYST_RESEARCH_API_KEY=
ANALYST_SMTP_HOST=
ANALYST_SMTP_FROM=
ANALYST_SMTP_USERNAME=
ANALYST_SMTP_PASSWORD=
ANALYST_S3_BUCKET=
ANALYST_S3_ENDPOINT=
# JSON list of application account IDs. Configure after creating the operator account.
ANALYST_ADMIN_USER_IDS=[]
# Named read-only PostgreSQL DSNs available to deployment administrators.
ANALYST_POSTGRES_SOURCES={}
