# Common local and Docker settings. Copy to .env before editing.
APP_ENV=development
POSTGRES_USER=analyst
POSTGRES_DB=analyst
POSTGRES_PASSWORD=

# Native services. A blank DATABASE_URL builds the URL from POSTGRES_* once
# POSTGRES_PASSWORD is set. An explicit URL overrides the individual settings.
# DATABASE_URL=postgresql+psycopg://analyst:<url-encoded-password>@127.0.0.1:5432/analyst
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# Enable these for a native Redis-backed setup. Celery uses REDIS_URL as
# its default broker. The optional result backend uses a separate Redis DB.
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Existing ANALYST_* settings take precedence within the same environment
# source. Compose supplies its own database URL, Redis URL, and eager mode.
# ANALYST_ORIGIN=http://localhost:3000
# ANALYST_EAGER=true
ANALYST_COOKIE_SECURE=false
ANALYST_LLM_PROVIDER=none
# ANALYST_LLM_PROVIDER=openai or gemini
ANALYST_LLM_MODEL=
ANALYST_LLM_API_KEY=
ANALYST_LLM_INPUT_COST_PER_MILLION=0
ANALYST_LLM_OUTPUT_COST_PER_MILLION=0
ANALYST_RESEARCH_API_KEY=
ANALYST_SMTP_HOST=
ANALYST_SMTP_FROM=
ANALYST_SMTP_USERNAME=
ANALYST_SMTP_PASSWORD=
ANALYST_S3_BUCKET=
ANALYST_S3_ENDPOINT=
# JSON list of application account IDs. Configure after creating the operator account.
ANALYST_ADMIN_USER_IDS=[]
# Named read-only PostgreSQL DSNs available to deployment administrators.
ANALYST_POSTGRES_SOURCES={}
